NODE_ENV=development
PORT=3000
DATABASE_URL=file:./dev.db

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The two secrets must be different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Uncomment when needed:
# OPENAI_API_KEY=
# REDIS_URL=redis://localhost:6379

printf '\n# Used only by `npx prisma db seed` to create the first admin user\nADMIN_EMAIL=\nADMIN_PASSWORD=\n' >> .env.example
